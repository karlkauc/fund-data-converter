# docker-compose.yml (converter.status20.net) – copy to .env. Leave USAGE_DB_URL empty
# to run without usage statistics (docs/USAGE_STATS.md).
USAGE_DB_URL=postgresql://tptconverter@62.238.116.11:5432/tptconverter_stats?sslmode=require
# Password: /home/deploy/tptconverter-db-password.txt on tanzapp-prod
# (also GCP secret tptconverter-db-password)
USAGE_DB_PASSWORD=
# Same value as GCP secret tptconverter-usage-hash-secret, so a visitor hashes alike on both deployments
USAGE_HASH_SECRET=
# GeoLite2 download at startup (country_code); empty = no country
MAXMIND_LICENSE_KEY=
